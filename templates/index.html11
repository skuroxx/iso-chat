<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="ISO: an AI chat workspace.">
  <title>ISO</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 3l12 7-12 7-12-7z' fill='%23111'/%3E%3Cpath d='M4 10l12 7v13L4 23z' fill='%23111' opacity='.55'/%3E%3Cpath d='M28 10l-12 7v13l12-7z' fill='%23111' opacity='.25'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/style.css?v={{ v('style.css') }}">
  <script src="/theme.js"></script>
</head>
<body>
  <!-- Vector sprite -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-cube" viewBox="0 0 32 32">
      <path class="f-top" d="M16 3l12 7-12 7-12-7z" fill="currentColor"/>
      <path class="f-left" d="M4 10l12 7v13L4 23z" fill="currentColor" opacity=".55"/>
      <path class="f-right" d="M28 10l-12 7v13l12-7z" fill="currentColor" opacity=".25"/>
    </symbol>
    <symbol id="i-plus" viewBox="0 0 20 20"><path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
    <symbol id="i-chat" viewBox="0 0 20 20"><path d="M3.5 4.5h13v9h-7l-3.5 3v-3h-2.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></symbol>
    <symbol id="i-send" viewBox="0 0 20 20"><path d="M10 16V4M5 9l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></symbol>
    <symbol id="i-theme" viewBox="0 0 20 20"><circle cx="10" cy="10" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10 3.8a6.2 6.2 0 0 1 0 12.4z" fill="currentColor"/></symbol>
    <symbol id="i-plan" viewBox="0 0 20 20"><path d="M3.5 5h13v11h-13zM3.5 8.5h13M7 3v4M13 3v4" fill="none" stroke="currentColor" stroke-width="1.4"/></symbol>
    <symbol id="i-learn" viewBox="0 0 20 20"><path d="M10 5.5C8 4 5.5 3.8 3 4.3v10.4c2.5-.5 5-.3 7 1.3 2-1.600 4.500-1.800 7-1.300V4.300c-2.500-.5-5-.3-7 1.200zM10 5.500V16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></symbol>
    <symbol id="i-idea" viewBox="0 0 20 20"><path d="M10 2.800l2 4.700 4.700 2-4.700 2-2 4.700-2-4.700-4.700-2 4.700-2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></symbol>
    <symbol id="i-copy" viewBox="0 0 20 20"><path d="M7 7h9v9H7zM4 13V4h9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></symbol>
    <symbol id="i-check" viewBox="0 0 20 20"><path d="M4.500 10.500l3.500 3.500 7.500-8" fill="none" stroke="currentColor" stroke-width="1.700"/></symbol>
    <symbol id="i-retry" viewBox="0 0 20 20"><path d="M16 10a6 6 0 1 1-2-4.500M16 3.500v3.500h-3.500" fill="none" stroke="currentColor" stroke-width="1.400"/></symbol>
    <symbol id="i-down" viewBox="0 0 20 20"><path d="M10 3.500v9M6 9l4 4 4-4M4 16h12" fill="none" stroke="currentColor" stroke-width="1.400"/></symbol>
    <symbol id="i-trash" viewBox="0 0 20 20"><path d="M4 6h12M8 6V4h4v2M6 6l.7 10h6.600L14 6" fill="none" stroke="currentColor" stroke-width="1.400" stroke-linejoin="round"/></symbol>
    <symbol id="i-stop" viewBox="0 0 20 20"><rect x="5" y="5" width="10" height="10" rx="1.500" fill="currentColor"/></symbol>
  </svg>

  <div class="backdrop" aria-hidden="true">
    <svg width="100%" height="100%">
      <defs>
        <pattern id="tri" width="60" height="103.92" patternUnits="userSpaceOnUse">
          <path d="M0 0H60M0 51.96H60M0 0L60 103.92M60 0L0 103.92" fill="none" stroke="currentColor" stroke-width="1"/>
        </pattern>
      </defs>
      <rect class="grid" width="100%" height="100%" fill="url(#tri)"/>
    </svg>
    <svg class="float f1" viewBox="0 0 32 32"><use href="#i-cube"/></svg>
    <svg class="float f2" viewBox="0 0 32 32"><use href="#i-cube"/></svg>
    <svg class="float f3" viewBox="0 0 32 32"><use href="#i-cube"/></svg>
    <svg class="float f4" viewBox="0 0 32 32"><use href="#i-cube"/></svg>
  </div>

  <div class="app">
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="ISO home">
        <svg class="logo" viewBox="0 0 32 32"><use href="#i-cube"/></svg>
        <span>iso</span>
      </a>

      <button class="btn primary" id="newChat" type="button">
        <svg class="ic"><use href="#i-plus"/></svg>
        <span>New chat</span>
      </button>

      <div class="list-title">Chats</div>
      <nav class="chats" id="chatList" aria-label="Saved chats"></nav>

      <div class="side-foot">
        <div class="meter" aria-label="Daily requests">
          <div class="meter-row"><span>Daily requests</span><span id="usageText">…</span></div>
          <div class="meter-bar"><i id="usageBar"></i></div>
        </div>
        <button class="btn ghost" id="themeToggle" type="button" aria-label="Switch theme">
          <svg class="ic"><use href="#i-theme"/></svg>
          <span>Theme</span>
        </button>
      </div>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <span class="crumb" id="title">New chat</span>
        <span class="status"><i class="dot"></i>Nemotron 3.5 Lightning</span>
        <button class="btn ghost icon" id="exportChat" type="button" title="Export chat as Markdown" aria-label="Export chat"><svg class="ic"><use href="#i-down"/></svg></button>
      </header>

      <section class="chat" aria-label="Conversation">
        <div class="scroll" id="scroll">
          <section class="welcome" id="welcome">
            <svg class="hero-logo" viewBox="0 0 32 32" aria-hidden="true">
              <path class="f-top" d="M16 3l12 7-12 7-12-7z" fill="currentColor"/>
              <path class="f-left" d="M4 10l12 7v13L4 23z" fill="currentColor" opacity=".55"/>
              <path class="f-right" d="M28 10l-12 7v13l12-7z" fill="currentColor" opacity=".25"/>
            </svg>
            <h1>What are you working on?</h1>
            <p>Ask a question, draft something, or think a problem through.</p>

            <div class="suggestions">
              <button class="suggest" type="button" data-prompt="Help me plan a focused and productive week.">
                <svg class="ic"><use href="#i-plan"/></svg>
                <span><strong>Plan my week</strong><small>Make room for deep work</small></span>
              </button>
              <button class="suggest" type="button" data-prompt="Explain a complex topic in simple terms, with examples.">
                <svg class="ic"><use href="#i-learn"/></svg>
                <span><strong>Learn something</strong><small>Complex ideas, simply explained</small></span>
              </button>
              <button class="suggest" type="button" data-prompt="Help me brainstorm original ideas for a digital product.">
                <svg class="ic"><use href="#i-idea"/></svg>
                <span><strong>Explore an idea</strong><small>Start from a blank page</small></span>
              </button>
            </div>
          </section>

          <div class="messages" id="messages" aria-live="polite" aria-relevant="additions"></div>
        </div>

        <form class="composer" id="chatForm" novalidate>
          <label class="sr" for="prompt">Your message</label>
          <textarea id="prompt" rows="1" maxlength="6000" placeholder="Message ISO" autocomplete="off" required></textarea>
          <div class="composer-row">
            <span class="count" id="count">0 / 6000</span>
            <button class="btn primary send" id="sendButton" type="submit">
              <span id="sendLabel">Send</span>
              <svg class="ic"><use href="#i-send"/></svg>
            </button>
          </div>
        </form>
      </section>
    </main>
  </div>

  <script src="/app.js?v={{ v('app.js') }}" defer></script>
</body>
</html>
